{
  "name": "loom",
  "version": "1.10.0-r10",
  "description": "Loom（织机）— Super-agent demo: continuous, efficient, proactive, durable",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "demo": "tsx src/demo.ts",
    "build": "vite build && tsc -p tsconfig.server.json",
